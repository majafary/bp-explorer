{
  "family": "ciam-blueprint-viewer",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::YOUR_ACCOUNT_ID:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::YOUR_ACCOUNT_ID:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "bp-explorer",
      "image": "YOUR_ECR_REGISTRY/bp-explorer:latest",
      "cpu": 256,
      "memory": 512,
      "essential": true,
      "portMappings": [
        {
          "containerPort": 80,
          "protocol": "tcp"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "wget --quiet --tries=1 --spider http://localhost:80/ || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 10
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/ciam-blueprint-viewer",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "bp-explorer"
        }
      }
    },
    {
      "name": "structurizr",
      "image": "YOUR_ECR_REGISTRY/structurizr:latest",
      "cpu": 512,
      "memory": 1024,
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "STRUCTURIZR_WORKSPACE_FILENAME",
          "value": "workspace"
        },
        {
          "name": "STRUCTURIZR_AUTO_REFRESH_INTERVAL",
          "value": "0"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -f http://localhost:8080/ || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 15
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/ciam-blueprint-viewer",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "structurizr"
        }
      }
    },
    {
      "name": "nginx-proxy",
      "image": "YOUR_ECR_REGISTRY/nginx-proxy:latest",
      "cpu": 256,
      "memory": 512,
      "essential": true,
      "portMappings": [
        {
          "containerPort": 80,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "STRUCTURIZR_HOST",
          "value": "localhost"
        },
        {
          "name": "STRUCTURIZR_PORT",
          "value": "8080"
        },
        {
          "name": "CORS_ORIGIN",
          "value": "*"
        }
      ],
      "dependsOn": [
        {
          "containerName": "structurizr",
          "condition": "HEALTHY"
        }
      ],
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "wget --quiet --tries=1 --spider http://localhost:80/health || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 5
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/ciam-blueprint-viewer",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "nginx-proxy"
        }
      }
    }
  ]
}
